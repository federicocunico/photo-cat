{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "photo-cat",
  "version": "0.1.0",
  "identifier": "com.photocat.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "photo-cat",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": { "webviewInstallMode": { "type": "offlineInstaller" } },
    "resources": {
      "../../assets/models/": "models/",
      "../../assets/selftest/": "selftest/",
      "../../assets/runtime/win-x64/": "runtime/",
      "../../assets/licenses/": "licenses/",
      "../../assets/native-sources/": "native-sources/",
      "../../assets/README.md": "ASSETS.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
